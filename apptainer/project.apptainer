Bootstrap: localimage
From: images/postgres:17-bookworm.sif

%files
    .. /pandora

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get -y --no-install-recommends install python3 python3-pip git ca-certificates

    cd /pandora
    test -f /pandora/pyproject.toml
    test -f /pandora/README.md
    test -f /pandora/LICENSE
    test -d /pandora/src

    # base package + RSA optional dependencies from pyproject.toml
    # Bookworm provides Python 3.11, compatible with NumPy 1.26.x.
    # Fail clearly rather than attempting an unsupported NumPy source build.
    python3 -m pip install --break-system-packages --only-binary=numpy "/pandora[rsa]"
