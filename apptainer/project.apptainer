Bootstrap: localimage
From: images/postgres:latest.sif

%files
    .. /pandora

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get -y --no-install-recommends install python3 python3-pip git ca-certificates

    cd /pandora
    test -f /pandora/pyproject.toml
    test -f /pandora/README.md
    test -f /pandora/LICENSE
    test -d /pandora/src

    # base package + RSA optional dependencies from pyproject.toml
    python3 -m pip install --break-system-packages "/pandora[rsa]"
