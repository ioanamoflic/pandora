Bootstrap: docker
From: postgres:latest

%files
#    ../requirements.txt requirements.txt
    ../pyproject.toml pyproject.toml

%post
    apt update
    apt-get -y install python3 git
    apt install python3-pip -y
    pip3 install --break-system-packages -e '.[rsa]'

